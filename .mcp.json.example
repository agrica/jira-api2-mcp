{
  "mcpServers": {
    "jira": {
      "command": "node",
      "args": ["--use-system-ca", "/chemin/vers/jira8-mcp/dist/index.js"],
      "env": {
        "JIRA_BASE_URL": "https://jira.example.com",
        "JIRA_PAT": "${JIRA_PAT}",
        "JIRA_ALLOW_WRITES": "false",
        "JIRA_ENABLE_XRAY": "false"
      }
    }
  }
}
